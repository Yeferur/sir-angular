{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prepare-vendor-scripts": "node -e \"const fs=require('fs'); const path=require('path'); const outDir=path.join('public','assets','vendor'); fs.mkdirSync(outDir,{recursive:true}); fs.copyFileSync(path.join('node_modules','leaflet','dist','leaflet.js'), path.join(outDir,'leaflet.js')); fs.copyFileSync(path.join('node_modules','leaflet-routing-machine','dist','leaflet-routing-machine.min.js'), path.join(outDir,'leaflet-routing-machine.min.js'));\"",
    "prestart": "npm run prepare-vendor-scripts",
    "prebuild": "npm run prepare-vendor-scripts",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@maplibre/ngx-maplibre-gl": "^21.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/maplibre-gl": "^1.13.2",
    "apexcharts": "^5.6.0",
    "chart.js": "^4.5.1",
    "flatpickr": "^4.6.13",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.2",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "maplibre-gl": "^5.6.0",
    "ng-apexcharts": "^2.0.4",
    "ngx-leaflet": "^0.0.16",
    "pdfjs-dist": "^5.4.530",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.2.8",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.18",
    "@types/leaflet-routing-machine": "^3.2.8",
    "baseline-browser-mapping": "^2.9.7",
    "cypress": "^15.13.1",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}
